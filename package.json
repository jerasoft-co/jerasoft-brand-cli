{
  "name": "@jerasoft/brand",
  "version": "1.1.0",
  "description": "CLI público para distribuição autenticada e verificável da marca JeraSoft.",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jerasoft-co/jerasoft-brand-cli.git"
  },
  "homepage": "https://github.com/jerasoft-co/jerasoft-brand-cli#readme",
  "bugs": {
    "url": "https://github.com/jerasoft-co/jerasoft-brand-cli/issues"
  },
  "bin": {
    "jerasoft-brand": "dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.3.6"
  },
  "packageManager": "bun@1.3.6",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "bun run tooling/build.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "pack:check": "bun run build && bun run tooling/pack-check.ts",
    "release": "bun run tooling/release.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run pack:check"
  },
  "dependencies": {
    "@clack/prompts": "1.7.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/bun": "1.3.6",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0"
  }
}
